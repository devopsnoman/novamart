NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://novamart:novamart_pass@localhost:5432/novamart
# Optional: if REDIS_URL is not set, the app runs without a cache
REDIS_URL=redis://localhost:6379
# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d
# Comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000
# Optional: failed login/register attempts allowed per IP per 15 minutes (default 20 in production)
# AUTH_RATE_LIMIT_MAX=20
# Optional: the seed script creates an admin user from these (password: 8+ characters)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-this-admin-password
